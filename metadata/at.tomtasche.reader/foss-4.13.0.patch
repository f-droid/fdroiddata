diff --git a/settings.gradle b/settings.gradle
index b754d6b5..ef443e1d 100644
--- a/settings.gradle
+++ b/settings.gradle
@@ -13,6 +13,14 @@ pluginManagement {
 // for a public artifact, which no clean source builder such as f-droid can supply.
 dependencyResolutionManagement {
     repositories {
+        // f-droid builds odr-core-android from OpenDocument.core into the local maven
+        // repository and takes it from there. exclusively: without the filter a version
+        // that has not been built locally would silently resolve to the prebuilt AAR on
+        // maven central, and a source-only build would quietly stop being one
+        exclusiveContent {
+            forRepository { mavenLocal() }
+            filter { includeModule("app.opendocument", "odr-core-android") }
+        }
         google()
         mavenCentral()
     }
